{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "hackboston",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-08",
	"compatibility_flags": ["nodejs_als"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"routes": [{ "pattern": "hackboston.dev", "custom_domain": true }],
	// The site is only public on hackboston.dev. Branch builds keep Preview URLs.
	"workers_dev": false,
	"preview_urls": true,
	"observability": {
		"enabled": true
	}
}
